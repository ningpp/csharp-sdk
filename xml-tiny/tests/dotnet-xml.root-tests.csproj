<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dotnet.xml.RootTests</AssemblyName>
    <RootNamespace>dotnet.xml.RootTests</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只编译根目录下的 CorrectnessTest.cs，避免包含各 xUnit 测试子项目文件 -->
    <Compile Remove="**\*.cs" />
    <Compile Include="CorrectnessTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\dotnet-xml.csproj" />
  </ItemGroup>

</Project>
