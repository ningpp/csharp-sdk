<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dotnet.xml.XPath.XPathDocument</AssemblyName>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>dotnet.xml.XPath.XPathDocument</RootNamespace>
    <DefineConstants>$(DefineConstants);FEATURE_XML_XPATH_ID</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\dotnet-xml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Common\*.cs" />
    <Compile Include="..\CoreFunctionLibrary\*.cs" />
    <Compile Include="..\CustomerScenarios\*.cs" />
    <Compile Include="..\FuncExpressions\*.cs" />
    <Compile Include="..\FuncLocation\*.cs" />
    <Compile Include="..\MiscellaneousCases\*.cs" />
    <Compile Include="..\TestsWithEncoding\*.cs" />
    <Compile Include="..\XPathExpressionTests\CompileTests.cs" />
    <Compile Remove="..\XPathExpressionTests\EvaluateTests.cs" />
    <Compile Include="CreateNavigatorFromXmlReader.cs" />
    <Compile Include="XmlReaderXPathTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\TestData\*.xml">
      <LogicalName>System.Xml.XPath.Tests.TestData.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
