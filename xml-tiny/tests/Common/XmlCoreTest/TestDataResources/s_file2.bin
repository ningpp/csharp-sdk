<?xml version="1.0" encoding="utf-8"?>
<!-- 
	Spec for Reader Factory Tests
-->

<TestModule Name="XmlReader" Created="3/11/2004 2:17:50 PM" Modified="" Version="1" Desc="XmlReader">
  <Owner Alias="amolkh" Type="test" />

  <Data>
    <filepath>TestData\RWFactory</filepath>
    <httppath></httppath>
    <DriverFunction>XmlReader</DriverFunction>
    <ResultTypes>
      <Type>Valid</Type>
      <Type>Invalid</Type>
    </ResultTypes>
  </Data>

  <!--
		General Comments :
		Values in this document are case sensitive, if you change the case for values, the driver code WILL break
		The API which takes the most parameter is targetted here. Dev code shows that all the other API just
		fill in the appropriate default values and call the longest API. And that is how it should be done.
	-->

  <TestCase Name="XmlReader.Create" Desc="XmlReader.Create">

    <Variation Id="1" Implemented="true" Pri="2" Desc="CL=Document;CC=true;ReaderType=Xsd;NameTable=new;NumOff=100;PosOff=1;IIS=true;ISL=true;IIC=false;IVW=false;Schemas=2;VEH=0;ProhibitDtd=true;IW=true;IP=true;IC=false;UrlResolver=custom;BaseUri=empty;Encoding=UTF-8;Load=StreamReader">
      <FilterCriteria>
        <ConformanceLevel>Document</ConformanceLevel>
        <CheckCharacters>true</CheckCharacters>
        <ReaderType>Xsd</ReaderType>
        <NameTable>new</NameTable>
        <LineNumberOffset>100</LineNumberOffset>
        <LinePositionOffset>1</LinePositionOffset>
        <IIS>true</IIS>
        <ISL>true</ISL>
        <IIC>false</IIC>
        <IVW>false</IVW>
        <Schemas>2</Schemas>
        <ValidationEventHandler>0</ValidationEventHandler>
        <ProhibitDtd>true</ProhibitDtd>
        <IgnoreWhiteSpace>true</IgnoreWhiteSpace>
        <IgnorePI>true</IgnorePI>
        <IgnoreComments>false</IgnoreComments>
        <XmlResolver>custom</XmlResolver>
        <BaseUri>empty</BaseUri>
        <Encoding>UTF-8</Encoding>
        <Load>StreamReader</Load>
      </FilterCriteria>
      <Data>
        <Result Type="Valid">
          <TestXmlFile>utf-8.xml</TestXmlFile>
          <TestXsdFiles>utf-8.xsd,utf-8-fragment.xsd</TestXsdFiles>
        </Result>
      </Data>
    </Variation>

    <Variation Id="2" Implemented="true" Pri="2" Desc="CL=Auto;CC=false;ReaderType=Dtd;NameTable=null;NumOff=1;PosOff=0;IIS=false;ISL=false;IIC=true;IVW=true;Schemas=0;VEH=2;ProhibitDtd=false;IW=false;IP=false;IC=true;UrlResolver=default;BaseUri=valid;Encoding=UTF-16;Load=StreamReader">
