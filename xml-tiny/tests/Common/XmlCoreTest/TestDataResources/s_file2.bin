    <Variation Id="3" Implemented="true" Pri="2" Desc="CL=Fragment;CC=true;ReaderType=Core;NameTable=custom;NumOff=0;PosOff=100;IIS=false;ISL=true;IIC=true;IVW=true;Schemas=1;VEH=1;ProhibitDtd=true;IW=false;IP=true;IC=true;UrlResolver=default;BaseUri=empty;Encoding=UTF-16BE;Load=CustomReader">
