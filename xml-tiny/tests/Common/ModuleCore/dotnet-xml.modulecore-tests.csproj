  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dotnet.xml.ModuleCore</AssemblyName>
    <RootNamespace>dotnet.xml.ModuleCore</RootNamespace>
    <Nullable>disable</Nullable>
